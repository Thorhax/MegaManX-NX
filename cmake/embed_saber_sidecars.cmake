# Embed the Saber Zero sidecars built from the tracked donor art into C.
#
# Invoked with -P. The sidecars come from assets/saber-zero (original Zashiko
# Mod art and sound, shipped with permission), never from a game ROM, so they
# ride inside the executable: a release cannot lose them and the player never
# has to regenerate anything.
#
#   -DOUT=<file.c> -DSABER=<saber-v1.bin> -DRIDE=<ride-zero-v1.bin>
#   -DSFX=<saber-sfx-v2.bin>

foreach(_var OUT SABER RIDE SFX)
    if(NOT DEFINED ${_var})
        message(FATAL_ERROR "embed_saber_sidecars: ${_var} is required")
    endif()
endforeach()

set(_body "/* Generated by cmake/embed_saber_sidecars.cmake. Do not edit. */\n")
string(APPEND _body "#include \"saber/mmx_saber_embedded.h\"\n\n")

foreach(_pair "Sprites;${SABER}" "Ride;${RIDE}" "Sfx;${SFX}")
    list(GET _pair 0 _name)
    list(GET _pair 1 _path)
    if(NOT EXISTS "${_path}")
        message(FATAL_ERROR "embed_saber_sidecars: missing ${_path}")
    endif()
    file(SIZE "${_path}" _size)
    if(_size EQUAL 0)
        message(FATAL_ERROR "embed_saber_sidecars: empty ${_path}")
    endif()
    file(READ "${_path}" _hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "((0x..,){16})" "\\1\n  " _bytes "${_bytes}")
    string(APPEND _body
        "const uint8_t kMmxSaberEmbedded${_name}[${_size}] = {\n  ${_bytes}\n};\n"
        "const size_t kMmxSaberEmbedded${_name}Size = ${_size};\n\n")
endforeach()

# Rewrite only on change so an unchanged sidecar does not recompile the blob.
set(_tmp "${OUT}.tmp")
file(WRITE "${_tmp}" "${_body}")
file(COPY_FILE "${_tmp}" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${_tmp}")
