     }
+#if defined(__SWITCH__)
+    /* Joined, never detached: the NRO must not return to the homebrew
+     * loader with a thread still alive (launcher_model_join_prep). */
+    g_prep_thread = th;
+    g_prep_thread_live = 1;
+#else
     pthread_detach(th);
+#endif
 #endif
     return 1;
 }
