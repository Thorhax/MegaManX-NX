     CloseHandle(th);
 #else
     pthread_t th;
+#if defined(__SWITCH__)
+    launcher_model_join_prep();
+#endif
     if (pthread_create(&th, NULL, prep_thread_main, &g_prep_job) != 0) {
         m->setup_preparing = false;
         safe_copy(m->setup_error, sizeof(m->setup_error), "Failed to start prepare thread.");
         m->setup_status[0] = '\0';
