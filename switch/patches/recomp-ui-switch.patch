+#if defined(__SWITCH__)
+/* One finger at a time, in logical units (the layout's coordinate space). */
+bool handle_switch_touch(const SDL_Event& e, const LauncherPlatform* p) {
+    static SDL_FingerID s_finger = -1;
+    if (e.type != SDL_FINGERDOWN && e.type != SDL_FINGERUP &&
+        e.type != SDL_FINGERMOTION)
+        return false;
+    if (e.type != SDL_FINGERDOWN && e.tfinger.fingerId != s_finger) return true;
+    if (e.type == SDL_FINGERDOWN && s_finger != -1) return true;
+    const float w = p && p->logical_w > 0 ? (float)p->logical_w : ImGui::GetIO().DisplaySize.x;
+    const float h = p && p->logical_h > 0 ? (float)p->logical_h : ImGui::GetIO().DisplaySize.y;
+    ImGuiIO& io = ImGui::GetIO();
+#if defined(IMGUI_VERSION_NUM) && IMGUI_VERSION_NUM >= 18950
+    io.AddMouseSourceEvent(ImGuiMouseSource_TouchScreen);
+#endif
+    io.AddMousePosEvent(e.tfinger.x * w, e.tfinger.y * h);
+    if (e.type == SDL_FINGERDOWN) {
+        s_finger = e.tfinger.fingerId;
+        io.AddMouseButtonEvent(ImGuiMouseButton_Left, true);
+    } else if (e.type == SDL_FINGERUP) {
+        io.AddMouseButtonEvent(ImGuiMouseButton_Left, false);
+        s_finger = -1;
+    }
+    return true;
+}
+#endif
