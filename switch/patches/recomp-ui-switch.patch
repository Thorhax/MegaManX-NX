+// High-contrast pass for small/handheld screens and couch distance (Nintendo
+// Switch by default; LNG_HIGH_CONTRAST=1 previews it on a desktop). Keeps each
+// console's palette and accent, but lifts secondary text, separates controls
+// from the panels they sit on, makes hover/focus unmistakable and enlarges the
+// small type. The CRT scanlines are dropped: on a 720p panel they only dim.
+static inline void launcher_theme_high_contrast(LauncherTheme* t) {
+    const LngColor a = t->accent;
+    t->text            = lng_rgba(1.0f, 1.0f, 1.0f, 1.0f);
+    t->text_muted      = lng_rgba(0.780f, 0.808f, 0.875f, 1.0f); // #C7CEDF
+    t->panel           = lng_rgba(0.110f, 0.137f, 0.204f, 1.0f); // #1C2334
+    t->panel_hovered   = lng_rgba(0.169f, 0.208f, 0.306f, 1.0f); // #2B354E
+    t->control         = lng_rgba(0.208f, 0.255f, 0.376f, 1.0f); // #354160
+    t->control_hovered = lng_rgba(a.r * 0.55f + 0.10f, a.g * 0.55f + 0.10f,
+                                  a.b * 0.55f + 0.10f, 1.0f);    // accent-tinted
+    t->border          = lng_rgba(0.431f, 0.494f, 0.651f, 1.0f); // #6E7EA6
+    t->focus_ring      = lng_rgba(0.400f, 1.000f, 1.000f, 1.0f); // bright cyan
+    t->focus_ring_width = 4.0f;
+    t->font_body  += 2.0f;
+    t->font_small += 4.0f;
+    t->row_height += 4.0f;
+    t->scanlines  = 0;
+}
+
+static inline LauncherTheme launcher_theme_by_name(const char* name) {
+    LauncherTheme t = launcher_theme_by_name_base(name);
+#if defined(__SWITCH__)
+    launcher_theme_high_contrast(&t);
+#else
+    {
+        const char* hc = getenv("LNG_HIGH_CONTRAST");
+        if (hc && hc[0] == '1') launcher_theme_high_contrast(&t);
+    }
+#endif
+    return t;
+}
+
 #ifdef __cplusplus
 }
 #endif
