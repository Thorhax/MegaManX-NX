+#if defined(__SWITCH__)
+/* A [perf] line every 600 frames (~10 s): there is no profiler or terminal on
+ * the console, so the log is how a slowdown is diagnosed. Stage times are
+ * means per simulated frame. "dropped" counts panel refreshes that passed
+ * without a new frame -- what a player sees as a stutter. A single slow loop
+ * iteration is not one: the GPU queue absorbs it. Only when refreshes were
+ * dropped does a second line break down the window's slowest iteration. */
+static void SwitchPerfTick(unsigned frame, uint64_t presentations) {
+  static double last_at, prev_iter, worst;
+  static unsigned last_frame, worst_frame;
+  static uint64_t last_presentations;
+  static double last_total[kProfileCount], last_throttle;
+  static double iter_total[kProfileCount], worst_stage[kProfileCount];
+  static double paused;
+  static unsigned pauses;
+  const double now = MonotonicSeconds();
+  /* Menus, rewind and loads hold the loop for a long stretch; that is not a
+   * stutter, so it leaves the window and is counted on its own. */
+  if (prev_iter > 0 && now - prev_iter > 0.25) {
+    paused += now - prev_iter;
+    ++pauses;
+  } else if (prev_iter > 0 && now - prev_iter > worst) {
+    worst = now - prev_iter;
+    worst_frame = frame;
+    for (unsigned i = 0; i < kProfileCount; ++i)
+      worst_stage[i] = g_timings[i].total - iter_total[i];
+  }
+  prev_iter = now;
+  for (unsigned i = 0; i < kProfileCount; ++i) iter_total[i] = g_timings[i].total;
+  if (frame % 600 != 0) return;
+  if (last_at > 0 && frame > last_frame) {
+    const double n = (double)(frame - last_frame), span = now - last_at - paused;
+    const double presented = (double)(presentations - last_presentations);
+    const double refreshes = span * g_vsync_refresh;
+    const unsigned dropped = refreshes - presented > 0.5
+        ? (unsigned)(refreshes - presented + 0.5) : 0;
+    double ms[kProfileCount];
+    for (unsigned i = 0; i < kProfileCount; ++i)
+      ms[i] = (g_timings[i].total - last_total[i]) * 1000.0 / n;
+    /* fprintf, not host_report_breadcrumb: the breadcrumb clips long lines.
+     * Flushed (below) once per window: without it a game closed from HOME
+     * lost every line still sitting in the stdio buffer. */
+    fprintf(stderr,
+        "[perf] frame=%u fps=%.1f dropped=%u | guest=%.2f raster=%.2f compose=%.2f "
+        "present=%.2f wait=%.2f audio_wait=%.2f ms/frame | %s pauses=%u\n",
+        frame, presented / span, dropped, ms[kProfileGuest], ms[kProfileRaster],
+        ms[kProfileCompose], ms[kProfilePresent], ms[kProfileWait],
+        (g_audio_throttle_seconds - last_throttle) * 1000.0 / n,
+        g_vsync_paced ? "vsync" : "timer", pauses);
+    if (dropped)
+      fprintf(stderr,
+          "[perf]   slowest frame=%u %.1fms: guest=%.2f raster=%.2f compose=%.2f "
+          "present=%.2f wait=%.2f ms\n",
+          worst_frame, worst * 1000.0, worst_stage[kProfileGuest] * 1000.0,
+          worst_stage[kProfileRaster] * 1000.0, worst_stage[kProfileCompose] * 1000.0,
+          worst_stage[kProfilePresent] * 1000.0, worst_stage[kProfileWait] * 1000.0);
+    fflush(stderr);
+  }
+  last_at = now;
+  last_frame = frame;
+  last_presentations = presentations;
+  last_throttle = g_audio_throttle_seconds;
+  for (unsigned i = 0; i < kProfileCount; ++i) last_total[i] = g_timings[i].total;
+  worst = 0;
+  paused = 0;
+  pauses = 0;
+}
+#endif
