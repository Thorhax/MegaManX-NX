+                     len ? " " : "", a);
+    if (n < 0 || (size_t)n >= sizeof(cmdline) - len) ok = 0;
+    else len += (size_t)n;
+  }
+  if (!ok) return 0;
+  if (R_FAILED(envSetNextLoad(nro, cmdline))) {
