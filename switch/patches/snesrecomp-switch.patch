+/* Vsync-paced presentation. The panel refreshes at 60 Hz and the SNES runs at
+ * 60.0988 Hz; pacing with a timer at the SNES rate *and* waiting for vsync made
+ * the two clocks beat: every ~43 frames the timer's wake-up (1 ms sleep
+ * granularity) landed past a vblank and that frame took an extra refresh. Here
+ * vsync alone paces the guest, one frame per refresh, and audio is resampled
+ * by the same 0.16% (~3 cents) so the sample queue stays level. If vsync stops
+ * blocking (frames arrive far faster than the panel), the timer takes over. */
+static bool g_vsync_paced;
+static int g_vsync_device_rate;   /* the opened device rate, for restoring */
+static double g_vsync_refresh = 60;
+
+static void SwitchVsyncConfigure(void) {
+  double refresh = DisplayRefresh();
+  if (!(refresh >= 50 && refresh <= 70)) refresh = 60;
+  g_vsync_refresh = refresh;
+  g_vsync_paced = VSyncInterval() == 1 && !PresentationDecoupled() &&
+      (g_simulation_hz > refresh ? g_simulation_hz - refresh : refresh - g_simulation_hz) <
+          0.01 * g_simulation_hz;
+  host_report_breadcrumb("pacing: %s (refresh=%.3f simulation=%.4f)",
+                         g_vsync_paced ? "vsync" : "timer", refresh, g_simulation_hz);
+}
+static void SwitchVsyncApplyAudioRate(void) {
+  if (g_vsync_device_rate <= 0) return;
+  const double rate = g_vsync_paced
+      ? g_vsync_device_rate * g_simulation_hz / g_vsync_refresh
+      : (double)g_vsync_device_rate;
+  if (g_audio_mutex) RtlApuLock();
+  RtlSetAudioOutputRateHz(rate);
+  if (g_audio_mutex) RtlApuUnlock();
+  host_report_breadcrumb("audio: resampling to %.2f Hz for %s pacing", rate,
+                         g_vsync_paced ? "vsync" : "timer");
+}
+/* Per presented frame: fall back to the timer if vsync is not holding the
+ * loop to the panel (or the player turned it off in the launcher). */
+static void SwitchVsyncGuard(void) {
+  static double last;
+  static unsigned fast;
+  if (!g_vsync_paced) { last = 0; return; }
+  const double now = MonotonicSeconds();
+  if (VSyncInterval() != 1) fast = 1000;
+  else if (last > 0 && now - last < 0.6 / g_vsync_refresh) ++fast;
+  else fast = 0;
+  last = now;
+  if (fast >= 30) {
+    g_vsync_paced = false;
+    SwitchVsyncApplyAudioRate();
+    host_report_breadcrumb("pacing: vsync is not limiting presentation; using the timer");
+    fast = 0;
+  }
+}
+#endif
